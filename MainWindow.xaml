<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200"
    Height="820"
    MinWidth="1000"
    MinHeight="700"
    Background="{StaticResource PageBrush}"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Kotak statistik -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="StatIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header -->
            <RowDefinition Height="Auto"/>   <!-- 1: Form + Informasi -->
            <RowDefinition Height="Auto"/>   <!-- 2: Search -->
            <RowDefinition Height="*"/>      <!-- 3: DataGrid -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE7BE;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="40"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="STUDENT MANAGEMENT SYSTEM"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <TextBlock Text="Manage student data"
                               Foreground="White"
                               FontSize="14"
                               Opacity="0.85"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TodayText}"
                               Foreground="White"
                               FontSize="13"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Welcome, Admin"
                               Foreground="White"
                               Opacity="0.85"
                               FontSize="13"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== FORM + INFORMASI ===================== -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== INPUT MAHASISWA ========== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE70F;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="18"
                                   Foreground="{StaticResource HeaderBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="NIM" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" MaxLength="20"
                                 Text="{Binding FormStudent.NIM, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Nama" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" MaxLength="100"
                                 Text="{Binding FormStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Jurusan" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding JurusanList}"
                                  SelectedItem="{Binding FormStudent.Jurusan}"/>

                        <TextBlock Grid.Row="3" Text="Gender" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding GenderList}"
                                  SelectedItem="{Binding FormStudent.Gender}"/>

                        <TextBlock Grid.Row="4" Text="Email" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" MaxLength="100"
                                 Text="{Binding FormStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Tombol -->
                    <StackPanel Orientation="Horizontal" Margin="90,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SaveButtonText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Hapus"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reset"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pesan status / validasi -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="90,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ========== INFORMASI / STATISTIK ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE9D2;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="18"
                                   Foreground="#2E7D32"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="INFORMASI" Style="{StaticResource SectionTitle}" Foreground="#2E7D32"/>
                    </StackPanel>

                    <!-- Total Mahasiswa -->
                    <Border Style="{StaticResource StatTile}" Background="#E3F2FD">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource StatIcon}"
                                       Foreground="{StaticResource PrimaryBrush}" FontSize="32"/>
                            <StackPanel>
                                <TextBlock Text="Total Mahasiswa" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding TotalStudents}" Style="{StaticResource StatValue}" FontSize="32"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2" Rows="2">
                        <!-- Informatika -->
                        <Border Style="{StaticResource StatTile}" Background="#E8F5E9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource StatIcon}" Foreground="#2E7D32"/>
                                <StackPanel>
                                    <TextBlock Text="Informatika" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding TotalInformatika}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sistem Informasi -->
                        <Border Style="{StaticResource StatTile}" Background="#F3E5F5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource StatIcon}" Foreground="#7B1FA2"/>
                                <StackPanel>
                                    <TextBlock Text="Sistem Informasi" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding TotalSistemInformasi}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Laki-laki -->
                        <Border Style="{StaticResource StatTile}" Background="#FFF3E0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource StatIcon}" Foreground="#EF6C00"/>
                                <StackPanel>
                                    <TextBlock Text="Laki-laki" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding TotalLakiLaki}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Perempuan -->
                        <Border Style="{StaticResource StatTile}" Background="#FFEBEE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource StatIcon}" Foreground="#C62828"/>
                                <StackPanel>
                                    <TextBlock Text="Perempuan" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding TotalPerempuan}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== SEARCH ===================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource HeaderBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Search" Style="{StaticResource SectionTitle}" FontSize="15"/>
                </StackPanel>

                <!-- Tekan Enter juga menjalankan SearchCommand -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,7"
                         ToolTip="Cari berdasarkan NIM, Nama, Jurusan, atau Email">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}" Margin="10,0,8,0" Padding="25,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Cari"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearSearchCommand}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Reset"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===================== DATAGRID ===================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,12,18,10">
                    <TextBlock Text="Daftar Mahasiswa" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <TextBlock Text="{Binding DisplayInfo}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#ECEFF1"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFD"
                          RowHeight="40"
                          FontSize="13"
                          Margin="1,0,1,1"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          CellStyle="{StaticResource GridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding No}" Width="50"/>
                        <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="100"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*"/>
                        <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="1.5*"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="110"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>

                        <!-- Kolom Aksi: Edit & Delete per baris -->
                        <DataGridTemplateColumn Header="Aksi" Width="110" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource RowEditButton}"
                                                Content="&#xE70F;"
                                                Command="{Binding DataContext.EditCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource RowDeleteButton}"
                                                Content="&#xE74D;"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
